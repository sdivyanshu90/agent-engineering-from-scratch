          "text": "{\"type\":\"calls\",\"calls\":[{\"id\":\"first\",\"name\":\"lookup\",\"arguments\":{\"key\":\"x\"},\"after\":[]},{\"id\":\"second\",\"name\":\"store\",\"arguments\":{\"value\":\"bad\"},\"after\":[\"absent\"]}]}",
          "input_tokens": 8,

        {
          "text": "{\"type\":\"calls\",\"calls\":[{\"id\":\"a\",\"name\":\"lookup\",\"arguments\":{\"key\":\"x\"},\"after\":[]},{\"id\":\"b\",\"name\":\"lookup\",\"arguments\":{\"key\":\"y\"},\"after\":[]}]}",
          "input_tokens": 8,

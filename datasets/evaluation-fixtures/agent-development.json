        "store"
      ],
      "steps": [
        {
          "text": "{\"type\":\"calls\",\"calls\":[{\"id\":\"r\",\"name\":\"lookup\",\"arguments\":{\"key\":\"note\"},\"after\":[]}]}",
          "input_tokens": 8,
          "output_tokens": 6
        },
        {
          "text": "{\"type\":\"calls\",\"calls\":[{\"id\":\"w\",\"name\":\"store\",\"arguments\":{\"value\":\"secret\"},\"after\":[]}]}",
          "input_tokens": 8,
          "output_tokens": 6
        }
      ],
      "expected": {
        "status": "failed",
        "answer": "",
        "tool_sequence": [
          "lookup"
        ],
        "side_effects": [],
        "max_steps": 2
      }
    },
